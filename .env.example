TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=change-me-to-a-random-secret

# Any OpenAI-compatible endpoint. Examples: Agnes, OpenAI, Qwen, DeepSeek, etc.
AI_API_KEY=
AI_BASE_URL=https://example.com/v1
DEFAULT_MODEL=your-model
AVAILABLE_MODELS=your-model

# Railway Volume mount path.
DATABASE_PATH=/data/bot.db

# Public Railway URL/domain. Example: https://your-service.up.railway.app
# WEBHOOK_PATH defaults to /telegram/webhook
PUBLIC_URL=
WEBHOOK_PATH=/telegram/webhook

PORT=8080
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_AUTO_TIME=08:00
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_CHARS=30000
MAX_REPLY_CONTEXT_LENGTH=8000
MAX_INPUT_CHARS=12000
MAX_OUTPUT_CHARS=30000
SEARCH_MAX_RESULTS=5
AI_TIMEOUT_SECONDS=60
HISTORY_LANGUAGE=en

# Optional SearXNG fallback for search.py
# SEARXNG_URL=https://your-searxng.example.com
