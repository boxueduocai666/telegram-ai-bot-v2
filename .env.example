TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=change-me-to-a-random-secret

# Any OpenAI-compatible endpoint (Agnes, Qwen, DeepSeek, etc.).
AI_API_KEY=
AI_BASE_URL=https://example.com/v1
DEFAULT_MODEL=your-model
AVAILABLE_MODELS=your-model
# Optional extra Agnes model IDs, comma-separated. /models discovery is also attempted.
AGNES_MODELS=

# Direct Gemini API. The three default model IDs are included by the code.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional extra Gemini model IDs, comma-separated.
GEMINI_MODELS=

# Persistent storage path.
DATABASE_PATH=/data/bot.db
PUBLIC_URL=
WEBHOOK_PATH=/telegram/webhook

PORT=8080
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_AUTO_TIME=08:00
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_CHARS=30000
MAX_REPLY_CONTEXT_LENGTH=8000
MAX_INPUT_CHARS=12000
MAX_OUTPUT_CHARS=30000
SEARCH_MAX_RESULTS=5
AI_TIMEOUT_SECONDS=60
HISTORY_LANGUAGE=en

# Optional SearXNG fallback for search.py
# SEARXNG_URL=https://your-searxng.example.com
